# Copy to .env to override the defaults. Every value below is optional:
# without a .env file the tool works with these exact defaults.

# Password for the local Neo4j container (minimum 8 characters).
NEO4J_PASSWORD=dnsinv-local

# Host ports, in case 7474 / 7687 are already taken on your machine.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
