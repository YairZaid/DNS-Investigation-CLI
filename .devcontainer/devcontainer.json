{
  // GitHub Codespaces: run the whole project in a browser, with nothing installed locally.
  // Only Codespaces and VS Code Dev Containers read this file; Docker Compose, the CLI and
  // CI ignore it. Inside the codespace the README commands work exactly as on a laptop.
  "name": "DNS Investigation CLI",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    // A Docker daemon inside the codespace, so `docker compose` runs Neo4j and the CLI
    // and bind mounts of the project folder work as they do locally.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },
  "forwardPorts": [7474, 7687],
  "portsAttributes": {
    "7474": { "label": "Neo4j Browser", "onAutoForward": "notify" },
    "7687": { "label": "Neo4j Bolt", "onAutoForward": "silent" }
  },
  // Pull Neo4j and build the CLI image while the codespace is created, so the first
  // command does not wait for them.
  "postCreateCommand": "docker compose pull neo4j && docker compose build cli",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
